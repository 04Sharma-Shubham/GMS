{
  "name": "gms/gym-management-system",
  "description": "Premium gym management system for PHP shared hosting",
  "type": "project",
  "require": {
    "php": ">=8.2",
    "ext-curl": "*",
    "ext-fileinfo": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-openssl": "*",
    "ext-pdo": "*",
    "chillerlan/php-qrcode": "^5.0",
    "dompdf/dompdf": "^3.1",
    "phpmailer/phpmailer": "^6.9"
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  }
}
